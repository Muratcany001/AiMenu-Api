{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Debug",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://elasticsearch:9200",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv8",
          "indexFormat": "aimenu-log-{0:yyyy.MM.dd}",
          "numberOfReplicas": 0,
          "typeName": null,
          "batchPostingLimit": 50,
          "period": 2,
          "inlineFields": true
        }
      }
    ]
  },
  "ElasticConfiguration": {
    "Uri": "http://elasticsearch:9200",
    "IndexName": "aimenu-log"
  },
  "ConnectionStrings": {
    "Redis": "pd-redis:6379",
    "DefaultConnection": "Server=pd-sql,1433;Database=AiMenuDb;User Id=sa;Password=SqlP@ssw0rd123!;TrustServerCertificate=True;"
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "super-guclu-bir-sifre-bu-olsun-deneme-123-abc-XYZ-!@#-6543214221",
    "Issuer": "https://localhost:7276",
    "Audience": "https://localhost:7276"
  }
}